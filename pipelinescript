pipeline {
    agent any 

    parameters {
        choice(name: 'action', choices: ['apply', 'destroy'], description: 'Terraform action')
    }

    stages {
        stage('checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/nikhilbansod7252/terraform-3tier-project.git'
            }
        }
        stage('init') {
            steps {
                sh 'terraform init'
            }
        }
        stage('validate') {
            steps {
                sh 'terraform validate'                
            }
        }
        stage('plan') {
            steps {
                sh 'terraform plan'
            }
        }
        stage('action') {
            steps {
                sh "terraform ${params.action} --auto-approve"
            }
        }
    }
}
